<Application x:Class="SvgCheck.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 不设 StartupUri：无头快照模式要在建窗之前接管启动流程 -->
  <Application.Resources>

    <!-- 配色：画布区暗（衬托产出本身），判据区亮（默认控件在亮底上才正确） -->
    <SolidColorBrush x:Key="Window"     Color="#FF2B2F36"/>
    <SolidColorBrush x:Key="Surface"    Color="#FFF7F8FA"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#FFECF0F2"/>
    <SolidColorBrush x:Key="Ink"        Color="#FF1C1F24"/>
    <SolidColorBrush x:Key="Muted"      Color="#FF5B6470"/>
    <SolidColorBrush x:Key="Accent"     Color="#FF2F7D7A"/>
    <SolidColorBrush x:Key="Pass"       Color="#FF2E7D5B"/>
    <SolidColorBrush x:Key="Warn"       Color="#FFB26B00"/>
    <SolidColorBrush x:Key="Fail"       Color="#FFC0392B"/>
    <SolidColorBrush x:Key="Unknown"    Color="#FF7A828C"/>

    <Style x:Key="Tool" TargetType="Button">
      <Setter Property="Background" Value="#FF3A3F48"/>
      <Setter Property="Foreground" Value="#FFE8EAED"/>
      <Setter Property="BorderBrush" Value="#FF565D68"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF4A5059"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

  </Application.Resources>
</Application>
