<Window x:Class="SvgCheck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rv="clr-namespace:SvgCheck.App.Rendering"
        Title="svgcheck 桌面版 —— 鹈鹕骑车基准体检器"
        Width="1320" Height="860" MinWidth="900" MinHeight="560"
        Background="{StaticResource Window}"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 工具条 -->
    <Border Grid.Row="0" Background="#FF22252B" Padding="12,10" BorderBrush="#FF3A3F48" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BtnOpen"  Style="{StaticResource Tool}" Content="选择文件" Click="OnOpen"/>
          <Button x:Name="BtnCopy"  Style="{StaticResource Tool}" Content="复制报告" Click="OnCopy" IsEnabled="False"/>
          <Button x:Name="BtnSave"  Style="{StaticResource Tool}" Content="导出…"   Click="OnSave" IsEnabled="False"/>
          <Button x:Name="BtnReset" Style="{StaticResource Tool}" Content="重置视图" Click="OnResetView" IsEnabled="False"/>
          <Button x:Name="BtnRoles" Style="{StaticResource Tool}" Content="清除角色" Click="OnClearRoles" IsEnabled="False"/>
          <TextBlock x:Name="FileName" Foreground="#FFB9C0C9" FontSize="13" VerticalAlignment="Center"
                     Margin="8,0,0,0" Text="未载入文件"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,18,0">
            <TextBlock Text="覆盖率" Foreground="#FF8A919B" FontSize="11" HorizontalAlignment="Right"/>
            <TextBlock x:Name="CoverageText" Text="—" Foreground="#FFE8EAED" FontSize="15"
                       FontWeight="SemiBold" HorizontalAlignment="Right"/>
          </StackPanel>
          <Border x:Name="ScoreBadge" Background="#FF3A3F48" CornerRadius="6" Padding="16,8" MinWidth="118">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="ScoreText" Text="—" Foreground="#FFE8EAED" FontSize="30" FontWeight="Bold"/>
              <TextBlock Text="/100" Foreground="#FF8A919B" FontSize="13" VerticalAlignment="Bottom" Margin="5,0,0,5"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 降级 / 低置信横幅 -->
    <Border x:Name="Banner" Grid.Row="1" Background="#FFF6E7B4" BorderBrush="#FFE0C060"
            BorderThickness="0,0,0,1" Padding="12,8" Visibility="Collapsed">
      <TextBlock x:Name="BannerText" Foreground="#FF5A4300" FontSize="12.5" TextWrapping="Wrap"/>
    </Border>

    <!-- 主区 -->
    <Grid Grid.Row="2" Margin="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="360"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="450" MinWidth="330"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#FF1E1F24" CornerRadius="6" BorderBrush="#FF3A3F48" BorderThickness="1">
        <Grid>
          <rv:SvgView x:Name="View"/>
          <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock Text="把 .svg 或 .html 拖进来" Foreground="#FF7E8791" FontSize="19" HorizontalAlignment="Center"/>
            <TextBlock Text="或点左上角「选择文件」。右键点图中的元素可以指定它扮演什么角色。"
                       Foreground="#FF5B6470" FontSize="12.5" HorizontalAlignment="Center" Margin="0,8,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>

      <Border Grid.Column="2" Background="{StaticResource Surface}" CornerRadius="6">
        <ScrollViewer x:Name="ScoreScroll" VerticalScrollBarVisibility="Auto" Padding="0">
          <StackPanel x:Name="ScorePanel" Margin="12"/>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- 状态栏 -->
    <Border Grid.Row="3" Background="#FF22252B" BorderBrush="#FF3A3F48" BorderThickness="0,1,0,0" Padding="12,6">
      <TextBlock x:Name="Status" Foreground="#FF8A919B" FontSize="12"
                 Text="零依赖 · 判据来自 rubric.json · 验不了 ≠ 通过"/>
    </Border>
  </Grid>
</Window>
