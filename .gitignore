__pycache__/
*.py[cod]
.venv/
venv/

# 本地备份（开发过程中的 .bak）
*.bak
*.bak-*

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 输出产物（体检报告之类）
out/
